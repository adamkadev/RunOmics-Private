{
  "name": "runomics",
  "version": "3.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tokens": "node scripts/generate-tokens.mjs",
    "test": "vitest run",
    "analyze": "ANALYZE=true next build",
    "test:coverage": "vitest run --coverage",
    "e2e:build": "dotenv -e .env.e2e -- next build",
    "e2e:start": "dotenv -e .env.e2e -- next start",
    "test:e2e": "dotenv -e .env.e2e -- playwright test",
    "screenshots": "dotenv -e .env.e2e -- playwright test --config playwright.screenshots.config.ts",
    "screenshots:clean": "rm -rf screenshots/output screenshots/.pw-artifacts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.0.0",
    "lucide-react": "^1.28.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "simple-icons": "^16.27.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.12",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "sharp": ">=0.35.0",
    "postcss": "^8.5.25",
    "google-gax": { "rimraf": "^6.0.1" },
    "uuid": "^11.1.1"
  }
}
