{
  "name": "runomics",
  "version": "4.13.2",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:data": "dotenv -e .env.local -- node scripts/prepare-data.mjs",
    "validate:data": "dotenv -e .env.local -- node --import tsx scripts/validate-data.ts",
    "maplibre:worker": "node scripts/copy-maplibre-worker.mjs",
    "predev": "npm run prepare:data && npm run maplibre:worker",
    "dev": "next dev",
    "prebuild": "npm run prepare:data && npm run validate:data && npm run maplibre:worker",
    "build": "next build",
    "start": "next start",
    "prelint": "npm run prepare:data",
    "lint": "eslint",
    "verify:private-data": "node scripts/verify_no_private_data.mjs",
    "pretypecheck": "npm run prepare:data",
    "typecheck": "tsc --noEmit",
    "verify": "npm run verify:private-data && npm run lint && npm run typecheck && npm run check:cycles && npm test",
    "tokens": "node scripts/generate-tokens.mjs",
    "build:coaching-rules": "node --import tsx scripts/generate-coaching-rules.ts",
    "demo:generate": "node scripts/generate_demo_data.mjs",
    "pretest": "npm run prepare:data",
    "test": "vitest run",
    "check:cycles": "node --import tsx scripts/check-import-cycles.ts",
    "analyze": "ANALYZE=true next build",
    "pretest:coverage": "npm run prepare:data",
    "test:coverage": "vitest run --coverage",
    "test:rules": "npx -y firebase-tools@15.31.0 emulators:exec --only firestore --project demo-runomics \"vitest run src/infrastructure/__tests__/firestoreRules.test.ts\"",
    "e2e:data": "node scripts/prepare-e2e-data.mjs",
    "e2e:build": "npm run e2e:data && dotenv -e .env.e2e -- node scripts/prepare-data.mjs && dotenv -e .env.e2e -- node --import tsx scripts/validate-data.ts && npm run maplibre:worker && dotenv -e .env.e2e -- next build",
    "e2e:start": "dotenv -e .env.e2e -- next start",
    "test:e2e": "dotenv -e .env.e2e -- playwright test",
    "screenshots": "dotenv -e .env.e2e -- playwright test --config playwright.screenshots.config.ts",
    "screenshots:clean": "rm -rf screenshots/output screenshots/.pw-artifacts",
    "set-owner-claim": "dotenv -e .env.local -- node scripts/set_owner_claim.mjs",
    "coach": "dotenv -e .env.prod -e .env.local -- node --conditions=react-server --import tsx scripts/coaching.ts",
    "coach:sync-garmin": "dotenv -e .env.local -- node --conditions=react-server --import tsx scripts/coaching-sync-garmin.ts",
    "coach:garmin-auth": "dotenv -e .env.local -- node scripts/garmin_auth.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.10.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "simple-icons": "^16.31.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@next/bundle-analyzer": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/geojson": "^7946",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "sharp": ">=0.35.4",
    "postcss": "^8.5.25",
    "google-gax": {
      "rimraf": "^6.0.1"
    },
    "uuid": "^11.1.1"
  }
}
