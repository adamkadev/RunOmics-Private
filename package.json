{
  "name": "runomics",
  "version": "3.1.0",
  "private": true,
  "scripts": {
    "prepare:data": "dotenv -e .env.local -- node scripts/prepare-data.mjs",
    "predev": "npm run prepare:data",
    "dev": "next dev",
    "prebuild": "npm run prepare:data",
    "build": "next build",
    "start": "next start",
    "prelint": "npm run prepare:data",
    "lint": "eslint",
    "pretypecheck": "npm run prepare:data",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/generate-tokens.mjs",
    "demo:generate": "node scripts/generate_demo_data.mjs",
    "pretest": "npm run prepare:data",
    "test": "vitest run",
    "analyze": "ANALYZE=true next build",
    "pretest:coverage": "npm run prepare:data",
    "test:coverage": "vitest run --coverage",
    "e2e:build": "dotenv -e .env.e2e -- node scripts/prepare-data.mjs && dotenv -e .env.e2e -- next build",
    "e2e:start": "dotenv -e .env.e2e -- next start",
    "test:e2e": "dotenv -e .env.e2e -- playwright test",
    "screenshots": "dotenv -e .env.e2e -- playwright test --config playwright.screenshots.config.ts",
    "screenshots:clean": "rm -rf screenshots/output screenshots/.pw-artifacts",
    "set-owner-claim": "dotenv -e .env.local -- node scripts/set_owner_claim.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.0.0",
    "lucide-react": "^1.18.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "simple-icons": "^16.23.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "axe-core": "^4.12.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "sharp": ">=0.35.0",
    "postcss": "^8.5.25",
    "google-gax": { "rimraf": "^6.0.1" },
    "uuid": "^11.1.1"
  }
}
