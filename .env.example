NEXT_PUBLIC_MAPTILER_TOKEN=your_maptiler_token_here
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id_here
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_firebase_web_push_vapid_key_here
NEXT_PUBLIC_OWNER_EMAIL=owner@email.com
# UI language, read at build time: en (default) or fr.
NEXT_PUBLIC_LOCALE=en
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY=your-firebase-private-key
INTERNAL_NOTIFY_SECRET=a-random-secret-shared-with-the-github-actions-workflows
# Informational/presentational RunOmics AI: Today insight, Week Purpose, Season,
# Analytics, run verdicts, PB celebration, shoe verdicts.
GEMINI_API_KEY=your-general-gemini-key
# Adaptive coaching only: bootstrap, post-activity evaluation, weekly review,
# KEEP/ADJUST/REPLAN recommendations, rolling block generation. A separate
# Google project on purpose - coaching never falls back to GEMINI_API_KEY, so
# the two free-tier quotas stay independent.
GEMINI_COACH_API_KEY=your-coach-gemini-key
# Optional coaching-only model override for the manual preview command.
# GEMINI_COACH_MODEL=gemini-3.6-flash
PRIVACY_ZONES=[[0,0],[0,0]]
PRIVACY_RADIUS_M=250

# Canonical local data checkout. The app, coaching CLI, and Python sync all honor
# this path. Keep it outside this code repository and outside public/.
# A typical layout has runomics-private/ and runomics-data-adam/ as siblings.
# RUNOMICS_DATA_DIR=../runomics-data-adam/data

# Private deployment source: where scripts/prepare-data.mjs fetches real
# Garmin-derived data into root data/ when no RUNOMICS_DATA_DIR is selected.
# That directory
# sits outside public/ on purpose, so the dataset is never served as a static
# asset. Leave unset for a portfolio/demo clone - without it, a deterministic
# synthetic dataset is generated automatically (npm install && npm run dev
# just works).
# Only set these in your own local .env.local and as GitHub Actions /
# Vercel secrets for the personal deployment - never commit real values.
#
# Must be https:// (not git@/ssh://) - scripts/fetch_private_data.mjs and
# scripts/push_private_data.mjs authenticate over HTTPS via GIT_ASKPASS,
# reading the token only from this process's own environment, never as a
# URL/argument, so it never lands in `ps`, .git/config, or a build log.
# RUNOMICS_DATA_REPO_URL=https://github.com/your-username/runomics-data.git
#
# A fine-grained GitHub PAT scoped to *only* that one repository.
# - Vercel (personal build, fetch_private_data.mjs): Contents: Read-only.
# - The sync.yml GitHub Actions secret (push_private_data.mjs) needs
#   Contents: Read and write instead - use a second, separately-scoped PAT
#   there if you want the Vercel side to stay strictly read-only.
# Set an expiration and rotate it periodically; fine-grained PATs support both.
# RUNOMICS_DATA_REPO_TOKEN=a-fine-grained-github-pat-scoped-to-that-one-repo
