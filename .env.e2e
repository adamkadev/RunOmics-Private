# Env for end-to-end tests (`npm run test:e2e`). Committed on purpose: every
# value here is either non-secret (Firebase web config is public by design -
# it ships in every browser bundle) or an e2e-only placeholder.
#
# No Firebase Admin credentials are needed here: the pages covered by the
# current e2e specs (dashboard, activities, analytics, calendar, records,
# goals, map, shoes, plan) are all built from data/*.json, not
# Firestore. Sign-in-gated flows (Settings, activity notes editing) aren't
# covered yet - see README > "End-to-end tests".

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDOSZtSVB0piiMAAsgVNjUtapTnyqaseLk
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=runomics-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=runomics-dev
NEXT_PUBLIC_FIREBASE_APP_ID=1:341498731566:web:414c976183f637fea353bf
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=341498731566

# The e2e workspace, regenerated from the demo generator by `npm run e2e:data`
# before every build. Setting it here is what keeps the suite off whatever
# RUNOMICS_DATA_DIR .env.local points at - a real athlete checkout locally,
# which made a local run and a CI run see different datasets. Next.js does not
# override a variable already present in the environment, so this wins over
# .env.local for the build and the server alike. Gitignored; never committed.
RUNOMICS_DATA_DIR=.e2e-data

# A personal dev server left running on 3000 would collide with the suite's own
# build, so the e2e server has a port of its own.
PORT=3100

# Deterministic locale for string assertions regardless of the shell's env.
NEXT_PUBLIC_LOCALE=en

# Not set on purpose - both degrade gracefully (map skips rendering, push
# notifications are opt-in via a button, never called on page load):
# NEXT_PUBLIC_MAPTILER_TOKEN=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=
