rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.owner == true;
    }

    // hrUnreliable is only ever true: an unmarked run leaves the field out.
    function isWellFormedNote() {
      return request.resource.data.keys().hasOnly(['note', 'tags', 'hrUnreliable'])
        && (!('hrUnreliable' in request.resource.data) || request.resource.data.hrUnreliable == true)
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 10;
    }

    // Read by the owner only: everyone else reads a note through the app
    // (/api/activities/[id]/note, admin SDK), behind a private site's gate.
    match /activityNotes/{activityId} {
      allow get: if isOwner();
      allow list: if isOwner();

      allow create, update: if isOwner() && isWellFormedNote();
      allow delete: if isOwner();
    }

    function isWellFormedRouteName() {
      return request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
    }

    // The names the athlete gave their recurring routes (App Fixes 1g).
    // The owner's alone: nothing else reads or writes them.
    match /routeNames/{routeKey} {
      allow get: if isOwner();
      allow list: if isOwner();

      allow create, update: if isOwner() && isWellFormedRouteName();
      allow delete: if isOwner();
    }

    function isWellFormedAvoidSpot() {
      let data = request.resource.data;
      return data.keys().hasAll(['lon', 'lat', 'radiusM', 'createdAt'])
        && data.keys().hasOnly(['lon', 'lat', 'radiusM', 'createdAt', 'reason'])
        && data.lon is number && data.lon >= -180 && data.lon <= 180
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.radiusM is int && data.radiusM >= 20 && data.radiusM <= 250
        && data.createdAt is string && data.createdAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('reason' in data) || data.reason in ['blocked', 'mud', 'unsafe']);
    }

    // Places the athlete marked for Explore's loops to go around: where they run is the owner's alone.
    match /avoidSpots/{spotId} {
      allow get: if isOwner();
      allow list: if isOwner();

      allow create, update: if isOwner() && isWellFormedAvoidSpot();
      allow delete: if isOwner();
    }

    function isWellFormedShoePick() {
      return request.resource.data.keys().hasOnly(['gearId'])
        && request.resource.data.gearId is string
        && request.resource.data.gearId.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    // The shoe the owner picked for a run, keyed by activity id. Gear is the owner's alone to change.
    match /runShoes/{activityId} {
      allow get: if isOwner();
      allow list: if isOwner();

      allow create, update: if isOwner() && isWellFormedShoePick();
      allow delete: if isOwner();
    }

    // One document, `default`: the shoe a run with none from Garmin counts toward.
    match /shoeSettings/{settingId} {
      allow get: if isOwner();
      allow list: if isOwner();

      allow create, update: if isOwner() && settingId == 'default' && isWellFormedShoePick();
      allow delete: if isOwner();
    }

    function isScore(data, field) {
      return !(field in data) || (data[field] is int && data[field] >= 1 && data[field] <= 5);
    }

    function isWellFormedNiggle(data) {
      return !('niggle' in data) || (
        data.niggle is map
        && data.niggle.keys().hasAll(['site', 'pain'])
        && data.niggle.keys().hasOnly(['site', 'side', 'pain', 'changesRun'])
        && data.niggle.site in ['foot', 'ankle', 'achilles', 'calf', 'shin', 'knee', 'hamstring', 'quad', 'hip', 'back', 'other']
        && data.niggle.pain is int && data.niggle.pain >= 0 && data.niggle.pain <= 10
        && (!('side' in data.niggle) || data.niggle.side in ['left', 'right'])
        && (!('changesRun' in data.niggle) || data.niggle.changesRun is bool)
      );
    }

    function isWellFormedCheckIn(date) {
      let data = request.resource.data;
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.keys().hasOnly(['sleep', 'soreness', 'stress', 'mood', 'ill', 'travel', 'niggle', 'skipped'])
        && isScore(data, 'sleep') && isScore(data, 'soreness') && isScore(data, 'stress') && isScore(data, 'mood')
        && (!('ill' in data) || data.ill is bool)
        && (!('travel' in data) || data.travel is bool)
        && (!('skipped' in data) || data.skipped in ['ill', 'rest', 'life'])
        && isWellFormedNiggle(data);
    }

    // The morning check-in and the day's skipped session, one document per local date. Health data: the owner's alone, the server reads it as admin.
    match /wellness/{date} {
      allow get: if isOwner();
      allow list: if isOwner();

      allow create, update: if isOwner() && isWellFormedCheckIn(date);
      allow delete: if isOwner();
    }

    // `categories` decides which pushes the server sends this device; without it, it gets every one.
    function isWellFormedPushToken(token) {
      let data = request.resource.data;
      return data.keys().hasOnly(['token', 'userAgent', 'updatedAt', 'categories'])
        && data.token == token
        && (!('categories' in data) || (
          data.categories is map
          && data.categories.keys().hasOnly(['training', 'shoes', 'records'])
          && data.categories.values().hasOnly([true, false])
        ));
    }

    match /pushTokens/{token} {
      allow create, update: if isOwner() && isWellFormedPushToken(token);
      allow delete: if isOwner();
    }

    // Each scheduled run and internal 5xx, written by the server (Admin SDK) alone.
    match /jobEvents/{eventId} {
      allow get, list: if isOwner();
      allow write: if false;
    }
  }
}
