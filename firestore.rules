rules_version = '2';

// RunOmics Firestore security rules — source of truth, versioned in the repo.
// Deploy with: firebase deploy --only firestore:rules
//
// Model: the whole dashboard is publicly readable (the app itself is a
// personal, read-only site for visitors), but every write (activity notes,
// goals, pbs, athlete profile, notification tokens) is restricted to the
// owner's Google account. The NEXT_PUBLIC_OWNER_EMAIL check in the UI is
// only a display gate — this file is the actual enforcement.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'adam.elkadaoui@gmail.com';
    }
  }
}
