rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.owner == true;
    }

    function isWellFormedNote() {
      return request.resource.data.keys().hasOnly(['note', 'tags'])
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 10;
    }

    // Read by the owner only: everyone else reads a note through the app
    // (/api/activities/[id]/note, admin SDK), behind a private site's gate.
    match /activityNotes/{activityId} {
      allow get: if isOwner();
      allow list: if isOwner();

      allow create, update: if isOwner() && isWellFormedNote();
      allow delete: if isOwner();
    }

    function isWellFormedRouteName() {
      return request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
    }

    // The names the athlete gave their recurring routes (App Fixes 1g).
    // The owner's alone: nothing else reads or writes them.
    match /routeNames/{routeKey} {
      allow get: if isOwner();
      allow list: if isOwner();

      allow create, update: if isOwner() && isWellFormedRouteName();
      allow delete: if isOwner();
    }

    function isScore(data, field) {
      return !(field in data) || (data[field] is int && data[field] >= 1 && data[field] <= 5);
    }

    function isWellFormedNiggle(data) {
      return !('niggle' in data) || (
        data.niggle is map
        && data.niggle.keys().hasAll(['site', 'pain'])
        && data.niggle.keys().hasOnly(['site', 'side', 'pain', 'changesRun'])
        && data.niggle.site in ['foot', 'ankle', 'achilles', 'calf', 'shin', 'knee', 'hamstring', 'quad', 'hip', 'back', 'other']
        && data.niggle.pain is int && data.niggle.pain >= 0 && data.niggle.pain <= 10
        && (!('side' in data.niggle) || data.niggle.side in ['left', 'right'])
        && (!('changesRun' in data.niggle) || data.niggle.changesRun is bool)
      );
    }

    function isWellFormedCheckIn(date) {
      let data = request.resource.data;
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.keys().hasOnly(['sleep', 'soreness', 'stress', 'mood', 'ill', 'travel', 'niggle'])
        && isScore(data, 'sleep') && isScore(data, 'soreness') && isScore(data, 'stress') && isScore(data, 'mood')
        && (!('ill' in data) || data.ill is bool)
        && (!('travel' in data) || data.travel is bool)
        && isWellFormedNiggle(data);
    }

    // The morning check-in, one document per local date. Health data: the owner's alone, the server reads it as admin.
    match /wellness/{date} {
      allow get: if isOwner();
      allow list: if isOwner();

      allow create, update: if isOwner() && isWellFormedCheckIn(date);
      allow delete: if isOwner();
    }

    // `categories` decides which pushes the server sends this device; without it, it gets every one.
    function isWellFormedPushToken(token) {
      let data = request.resource.data;
      return data.keys().hasOnly(['token', 'userAgent', 'updatedAt', 'categories'])
        && data.token == token
        && (!('categories' in data) || (
          data.categories is map
          && data.categories.keys().hasOnly(['training', 'shoes', 'records'])
          && data.categories.values().hasOnly([true, false])
        ));
    }

    match /pushTokens/{token} {
      allow create, update: if isOwner() && isWellFormedPushToken(token);
      allow delete: if isOwner();
    }
  }
}
