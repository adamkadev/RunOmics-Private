# The runtime packages at exactly the versions requirements.txt locks, plus
# the test and lint tools. requirements-dev.txt is compiled from this file:
#   pip-compile --generate-hashes --strip-extras --allow-unsafe -o requirements-dev.txt requirements-dev.in
-c requirements.txt
-r requirements.in
pytest
ruff
# pytest needs colorama on Windows only, so a lock compiled on Linux would leave
# it out, and `pip install --require-hashes` would then refuse on Windows.
# Listed here so every platform's hash is in the lock.
colorama
