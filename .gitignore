# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# generated screenshot audit output (regenerated on demand via `npm run screenshots`)
/screenshots/output/
/screenshots/.pw-artifacts/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# garmin FIT binaries - cached by GitHub Actions, not tracked in git
/public/fit/

# race-day cover photos (README > public/events/) - none tracked today, but
# guard against a future `git add .` picking one up by accident.
/public/events/

# real Garmin-derived data (Phase 2): inert today - this repo still tracks
# public/data/ itself, and gitignore never untracks an already-tracked file.
# Only takes effect once that data moves to the private data repository and
# is deliberately untracked here (`git rm --cached -r public/data`).
/public/data/

# Firebase service-account key files, if one is ever downloaded locally -
# Admin SDK credentials here are env-var based (see firebase-admin.ts), so
# none should exist, but this is cheap insurance against the common mistake.
*serviceAccountKey*.json
firebase-adminsdk-*.json
firebase-debug.log
firestore-debug.log

# claude memory
/.claude/
CLAUDE.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the e2e env: no secrets in it, see README > "End-to-end tests".
!.env.e2e
# ...and the documented template: placeholders only, never real values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.pyc
