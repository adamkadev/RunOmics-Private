# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/.coach-previews/
# The coaching prompt and its pasted reply both carry health data, and the
# documented CLI writes them wherever --prompt-out points.
/coach-prompt.md
/answer.json

# generated screenshot audit output (regenerated on demand via `npm run screenshots`)
/screenshots/output/
/screenshots/.pw-artifacts/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# garmin FIT binaries - cached by GitHub Actions, not tracked in git
/public/fit/
/.fit-cache/

# maplibre's worker + shared module, copied out of node_modules at build time
# (npm run maplibre:worker) so they stay in step with the installed version
/public/maplibre/

# race-day cover photos (README > public/events/) - none tracked today, but
# guard against a future `git add .` picking one up by accident.
/public/events/

# real Garmin-derived data: the canonical local copy lives in a separate private
# checkout selected by RUNOMICS_DATA_DIR. /data/ is only this repository's ignored,
# server-only default/runtime workspace. /public/data/ is a retired legacy path;
# it remains ignored as defense-in-depth because public/ is served statically.
/data/
/public/data/

# the Explore design handoff's uploads are screenshots of the real Activities
# map (real tracks, the home marker) the mock-ups were drawn over: they stay on
# the machine that has them (verify_no_private_data.mjs flags any tracked one).
/design_handoff_explore/design/uploads/

# the throwaway demo workspace `npm run e2e:data` regenerates before every
# Playwright build - never a real dataset, never worth committing.
/.e2e-data/

# the optimistic-concurrency marker fetch_private_data.mjs writes beside a data
# workspace (see scripts/private_data_revision.mjs) - workspace state, never
# tracked, and deliberately outside data/ so it is not pushed as athlete data.
/.data.base-revision.json

# Firebase service-account key files, if one is ever downloaded locally -
# Admin SDK credentials here are env-var based (see firebase-admin.ts), so
# none should exist, but this is cheap insurance against the common mistake.
*serviceAccountKey*.json
firebase-adminsdk-*.json
firebase-debug.log
firestore-debug.log

# claude memory, except the skills that belong to the project
/.claude/*
!/.claude/skills/
CLAUDE.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the e2e env: no secrets in it, see README > "End-to-end tests".
!.env.e2e
# ...and the documented template: placeholders only, never real values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.pyc
.venv/